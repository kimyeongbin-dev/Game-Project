# ==============================================
# Game Project Backend - 환경 변수 설정
# ==============================================
# 이 파일을 .env로 복사한 후 값을 설정하세요.
# cp .env.example .env
# ==============================================

# 환경 설정 (development, staging, production)
APP_ENV=development

# 데이터베이스 설정
DB_ENABLED=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quoridor_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# 전체 DB URL (개별 설정보다 우선)
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/quoridor_db

# 보안 설정
SECRET_KEY=your-secret-key-here-change-in-production
SESSION_EXPIRE_HOURS=24

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# CORS 설정 (쉼표로 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# 로깅 설정
LOG_LEVEL=INFO
LOG_SQL_QUERIES=false

# HTTPS/SSL 설정 (프로덕션)
SSL_ENABLED=false
SSL_CERT_FILE=
SSL_KEY_FILE=

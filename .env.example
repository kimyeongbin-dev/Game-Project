# 게임모아 Docker 환경 변수
# 이 파일을 .env 로 복사한 후 값을 채우세요. .env 는 절대 커밋하지 않습니다.

# ---------------------------------------------------------------------------
# PostgreSQL (메인 데이터베이스)
# ---------------------------------------------------------------------------
POSTGRES_DB=gamemoa
POSTGRES_TEST_DB=gamemoa_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis (매치메이킹 / 실시간 방 상태 / 턴 타이머 / Pub-Sub / 레이트 리미터)
# 논리 DB: 0=앱 상태, 1=테스트, 2=레이트 리미터
# ---------------------------------------------------------------------------
REDIS_PORT=6379
# requirepass. **필수** — 비어 있으면 compose 가 기동을 거부한다(기본값 없음). 무작위 값을 넣는다
#   python -c "import secrets; print(secrets.token_hex(24))"
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# 레이트 리미팅 (분당 요청 수 / 클라이언트 IP 기준)
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# 서버
# ---------------------------------------------------------------------------
SERVER_PORT=8000
DB_ENABLED=true
# access token 검증 키(HS256, platform.md §1.3). 비어 있으면 WS 접속이 전부 거부된다. production 은 32자 이상 필수
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ---------------------------------------------------------------------------
# 외부 연동 (구현 단계에서 채움)
# ---------------------------------------------------------------------------
# 카카오 소셜 로그인 (§1.1)
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=

# Cloudflare R2 - 퍼즐 이미지 스토리지 (§4.3)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

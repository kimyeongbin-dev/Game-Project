# =============================================================================
# 줄바꿈 / 인코딩 정책
#   - 모든 텍스트 파일은 저장소와 작업 트리 모두 LF
#   - 인코딩은 UTF-8 (BOM 없음)
#   - 예외: Windows 배치 스크립트만 CRLF (cmd.exe 가 LF 를 제대로 못 읽음)
#
# 이 파일의 eol=lf 는 core.autocrlf 설정보다 우선한다.
# =============================================================================

# 기본: 텍스트로 감지되는 모든 파일을 LF 로 정규화
* text=auto eol=lf

# ----------------------------------------------------------------------------
# Windows 전용 스크립트 — CRLF 필수
# ----------------------------------------------------------------------------
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Gradle 래퍼: 셸 스크립트는 LF, 배치는 CRLF
client/android/gradlew      text eol=lf
client/android/gradlew.bat  text eol=crlf

# ----------------------------------------------------------------------------
# 바이너리 — 절대 변환하지 않음
# ----------------------------------------------------------------------------
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.bmp    binary
*.svgz   binary

*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.eot    binary

*.mp3    binary
*.wav    binary
*.ogg    binary
*.m4a    binary
*.mp4    binary

*.sqlite binary
*.sqlite3 binary
*.db     binary

*.zip    binary
*.gz     binary
*.tar    binary
*.7z     binary
*.jar    binary
*.aab    binary
*.apk    binary
*.ipa    binary
*.pdf    binary

*.so     binary
*.dylib  binary
